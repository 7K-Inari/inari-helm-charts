{
  "$schema": "https://json.schemastore.org/chart",
  "title": "platform-config values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "object",
          "description": "Extra labels applied to every first-party resource."
        },
        "imageRegistry": {
          "type": "string",
          "description": "Registry prefix prepended to every image repository rendered by this chart (mirrored/air-gapped installs)."
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of pre-created pull secrets rendered into every pod spec (and the Keycloak operand via unsupported podTemplate)."
        }
      }
    },
    "gateway": {
      "type": "object",
      "description": "parentRef to an ALREADY-EXISTING Gateway. The chart never creates a Gateway/GatewayClass; a Gateway controller and Gateway must be deployed beforehand. Required (gateway.name) when any *.route.enabled=true.",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "sectionName": {
          "type": "string"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "auth": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string",
              "description": "Name of a pre-provisioned secret (e.g. Vault/ESO) carrying inari-uri, openfga-uri, openfga-password, postgres-password, username, password (and keycloak-* keys only for the bundled Keycloak)."
            },
            "roleSecrets": {
              "type": "object",
              "description": "Only with existingSecret: per-role kubernetes.io/basic-auth secrets (username+password) for CNPG managed.roles.",
              "properties": {
                "keycloak": {
                  "type": "string"
                },
                "openfga": {
                  "type": "string"
                }
              }
            },
            "passwords": {
              "type": "object",
              "properties": {
                "inari": {
                  "type": "string"
                },
                "keycloak": {
                  "type": "string"
                },
                "openfga": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "keycloak": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "description": "Keycloak image. global.imageRegistry is prepended to the repository; digest wins over tag.",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          },
          "required": [
            "repository",
            "tag"
          ]
        },
        "hookImage": {
          "type": "object",
          "description": "Image for the curl-based PostSync hook jobs (client-setup, realm-verify).",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            }
          },
          "required": [
            "repository",
            "tag"
          ]
        },
        "baseUrl": {
          "type": "string",
          "description": "Override the in-cluster/admin backchannel base URL. Empty = derived."
        },
        "route": {
          "type": "object",
          "description": "HTTPRoute exposing Keycloak via the Gateway referenced in gateway:.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "annotations": {
              "type": "object",
              "description": "Extra annotations added to the HTTPRoute.",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "adminRole": {
          "type": "string",
          "minLength": 1,
          "description": "Client role on the inari-server client authorizing platform-admin API endpoints.",
          "default": "inari-platform-admin"
        },
        "external": {
          "type": "object",
          "description": "Required when keycloak.enabled=false.",
          "properties": {
            "baseUrl": {
              "type": "string"
            },
            "issuerUrl": {
              "type": "string"
            },
            "adminSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "clientIdKey": {
                  "type": "string"
                },
                "clientSecretKey": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            "importInto": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "namespace": {
                  "type": "string"
                }
              }
            }
          }
        },
        "realmSync": {
          "type": "object",
          "description": "Idempotent realm sync via keycloak-config-cli on every ArgoCD sync — keeps the realm (clients, mappers, users) in line with the chart across syncs, unlike the one-shot KeycloakRealmImport.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string"
                },
                "digest": {
                  "type": "string"
                }
              },
              "required": [
                "repository",
                "tag"
              ]
            }
          }
        },
        "adminClient": {
          "type": "object",
          "description": "Confidential client (service account) used by inari-server / inari-operator for Keycloak Admin REST calls via client_credentials.",
          "properties": {
            "clientId": {
              "type": "string"
            },
            "secret": {
              "type": "string"
            }
          }
        }
      }
    },
    "dataProtection": {
      "type": "object",
      "description": "Prune/uninstall safety for stateful resources.",
      "properties": {
        "keepOnUninstall": {
          "type": "boolean",
          "description": "Add argocd.argoproj.io/sync-options=Prune=false and helm.sh/resource-policy=keep to the CNPG Cluster so a prune/uninstall does not wipe the database."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "keycloak": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "keycloak": {
            "properties": {
              "external": {
                "required": [
                  "baseUrl",
                  "issuerUrl",
                  "adminSecret"
                ],
                "properties": {
                  "baseUrl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "issuerUrl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "adminSecret": {
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "description": "Platform glue chart for the Inari GitOps stack (CNPG Cluster, db secrets, Keycloak realm glue). This chart NEVER installs operators: the CNPG operator and the Keycloak operator (incl. their CRDs) are separate ArgoCD Applications. keycloak.enabled=true deploys a dedicated Keycloak instance via the existing operator; false uses keycloak.external (an existing instance)."
}
