{{- $clusterIds := list -}}
{{- range .Values.keycloak.dexClusters -}}
{{- if has .id $clusterIds -}}
{{- fail (printf "keycloak.dexClusters: duplicate id %q — client ids cluster-<id>-dex must be unique" .id) -}}
{{- end -}}
{{- $clusterIds = append $clusterIds .id -}}
{{- end -}}
{
  "realm": "inari",
  "enabled": true,
  "displayName": "Inari Platform",
  "organizationsEnabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "internationalizationEnabled": false,
  "attributes": {
    "org.inari/managed-by": "inari-helm-charts"
  },
  "defaultDefaultClientScopes": [
    "basic",
    "web-origins",
    "acr",
    "profile",
    "roles",
    "email",
    "organization"
  ],
  "groups": [
    {
      "name": "platform-admins",
      "path": "/platform-admins"
    }
  ],
  "users": [
    {
      "username": "dev-admin",
      "enabled": true,
      "email": "dev-admin@inari.local",
      "groups": ["/platform-admins"],
      "credentials": [
        {
          "type": "password",
          "value": "dev-admin",
          "temporary": false
        }
      ],
      "clientRoles": {
        "inari-server": [{{ .Values.keycloak.adminRole | toJson }}]
      }
    }
  ],
  "roles": {
    "client": {
      "inari-server": [
        {
          "name": {{ .Values.keycloak.adminRole | toJson }},
          "description": "Inari platform administrator"
        }
      ]
    }
  },
  "clientScopes": [
    {
      "name": "aud-inari-agent-gateway",
      "description": "Adds aud=inari-agent-gateway to access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-inari-agent-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "inari-agent-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "aud-inari-extension-gateway",
      "description": "Adds aud=inari-extension-gateway to access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-inari-extension-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "inari-extension-gateway",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "aud-kubernetes",
      "description": "Adds aud=kubernetes to access tokens (tenant-cluster apiserver OIDC)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-kubernetes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "kubernetes",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": {{ .Values.keycloak.adminClient.clientId | toJson }},
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": {{ .Values.keycloak.adminClient.secret | toJson }},
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "inari-server",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://keycloak.local:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://keycloak.local:8080"
      ],
      "defaultClientScopes": [
        "basic",
        "openid",
        "profile",
        "email",
        "organization"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-inari-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "inari-server",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "inari-cli",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "defaultClientScopes": [
        "basic",
        "openid",
        "profile",
        "email",
        "organization"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-inari-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "inari-server",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "inari-ui",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": {{ .Values.keycloak.consoleRedirectUris | toJson }},
      "webOrigins": {{ .Values.keycloak.consoleWebOrigins | toJson }},
      "defaultClientScopes": [
        "basic",
        "openid",
        "profile",
        "email",
        "organization"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-inari-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "inari-server",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }{{- range .Values.keycloak.dexClusters }},
    {
      "clientId": {{ printf "cluster-%s-dex" .id | toJson }},
      "description": "Cluster-local Dex for tenant cluster {{ .id }} (OIDC pass-through + token exchange into extension audiences). Runtime provisioning/secret rotation is owned by inari-server (W2); the secret here is a realm-creation placeholder.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": {{ .secret | toJson }},
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "redirectUris": {{ .redirectUris | default (list (printf "https://dex.cluster-%s.local/dex/callback" .id)) | toJson }},
      "defaultClientScopes": [
        "basic",
        "openid",
        "profile",
        "email",
        "organization"
      ],
      "optionalClientScopes": [{{- $auds := .audiences -}}{{- if not (hasKey . "audiences") -}}{{- $auds = list "kubernetes" "inari-extension-gateway" -}}{{- end -}}{{- range $i, $a := $auds }}{{ if $i }}, {{ end }}{{ printf "aud-%s" $a | toJson }}{{- end }}]
    }{{- end }}
  ]
}